{# Master TikZ template for HF architecture diagrams in Anthropic warm-pastel palette.
   Consumed by render_tikz.py with a `spec` dict from extract_arch.py.

   Variables:
     spec.model: dims/flags/family/summary/compress_ratios
     spec.blocks: top-level block list
     opts.show_mtp: bool — include MTP branch if model has it
     opts.theme: 'anthropic' (only theme implemented for now)
#}
{% raw %}\documentclass[tikz,border=12pt]{standalone}
\usepackage{xcolor}
\usepackage{tikz}
\usepackage{amsmath}
\usepackage[mathrm=sym]{unicode-math}
\setmathfont{FiraMath-Regular.otf}
\usetikzlibrary{arrows.meta, positioning, fit, backgrounds, calc, shapes.geometric, shapes.misc, decorations.pathreplacing}

\IfFileExists{fontspec.sty}{%
  \usepackage{fontspec}
  \IfFontExistsTF{SF Pro Text}{%
    \setsansfont{SF Pro Text}[BoldFont=SF Pro Text Semibold]
  }{}%
  \IfFontExistsTF{SF Mono}{%
    \setmonofont{SF Mono}
  }{}%
}{}

